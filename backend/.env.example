# Supabase connection url
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
PORT=5001
# Download the root certificate from Supabase Database settings.
# Relative paths resolve from backend/. Enables verified TLS in development too.
DB_SSL_CA_FILE=

# Public origin for links in emails (use http://localhost:3000 with Vite).
APP_URL=http://localhost:5001
# Generate once with `npm run configure:accounts`. Keep this key private and
# backed up: changing it makes existing encrypted cards and queued mail unreadable.
DATA_ENCRYPTION_KEY=

# Use a real SMTP provider for the demo. Port 587 uses STARTTLS; 465 uses TLS.
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional, development only: MAIL_MODE=file writes emails into backend/.mail/.
# File mode does not deliver email. Never use it to demonstrate real delivery.
