{
  "name": "ces-backend",
  "version": "1.0.0",
  "description": "Cinema E-Booking System — Express + PostgreSQL (Supabase) backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
